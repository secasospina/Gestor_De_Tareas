// Reglas de seguridad de Firestore.
// Se copian en la consola de Firebase → Firestore → Reglas.
// Garantizan EN EL SERVIDOR que cada usuario solo acceda a sus propias tareas,
// aunque alguien intente saltarse el frontend.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Campos permitidos en una tarea: cualquier otro campo se rechaza
    // (evita que se guarden datos extra o basura en los documentos).
    // priority y dueDate son opcionales para que las tareas creadas antes
    // de existir esos campos se puedan seguir editando.
    function hasOnlyAllowedFields(data) {
      return data.keys().hasOnly(['userId', 'title', 'description', 'completed', 'priority', 'dueDate', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['userId', 'title', 'description', 'completed', 'createdAt', 'updatedAt']);
    }

    // Si vienen priority o dueDate, deben tener un valor válido.
    function hasValidOptionalFields(data) {
      return (!('priority' in data) || data.priority in ['low', 'medium', 'high'])
        && (!('dueDate' in data)
          || data.dueDate == null
          || (data.dueDate is string && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    // Valida la forma de una tarea (los límites coinciden con src/utils/tasks.ts).
    // trim() evita que un título de solo espacios pase la validación.
    function isValidTask(data) {
      return hasOnlyAllowedFields(data)
        && hasValidOptionalFields(data)
        && data.title is string
        && data.title.trim().size() > 0
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() <= 500
        && data.completed is bool;
    }

    match /tasks/{taskId} {
      // Leer o borrar: solo si la tarea es del usuario autenticado.
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Crear: el userId debe ser el del propio usuario y las fechas deben ser
      // la hora del servidor (el cliente usa serverTimestamp(), no puede inventarlas).
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && isValidTask(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Editar: debe ser el dueño, no puede cambiar el userId ni la fecha de
      // creación, y la fecha de actualización debe ser la hora del servidor.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && isValidTask(request.resource.data);
    }
  }
}
